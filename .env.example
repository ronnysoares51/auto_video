# ==============================================================================
# Website Video Automation Configuration
# ==============================================================================

# Your Website / Product Info
TARGET_WEBSITE_NAME="WebResume.live"
TARGET_WEBSITE_URL="https://webresume.live"
TARGET_WEBSITE_FEATURES="148+ interactive templates, AI cover letters and resumes, 7-day free trial"

# Short Video Maker Service
SHORT_VIDEO_MAKER_URL="http://localhost:3123"
PEXELS_API_KEY="your_pexels_api_key_here" # Free key from https://www.pexels.com/api/

# Video Styling
SHORT_VIDEO_VOICE="af_heart" # af_heart, af_bella, am_adam, am_michael, etc.
SHORT_VIDEO_MUSIC="chill"    # chill, happy, excited, dark, hopeful, etc.
SHORT_VIDEO_ORIENTATION="portrait" # portrait (9:16) or landscape (16:9)
SHORT_VIDEO_CAPTION_POS="bottom"   # bottom, center, top
SHORT_VIDEO_CAPTION_BG="blue"      # blue, black, yellow, etc.

# Telegram (bot privado: controle e envio de vídeos para revisão)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"
ENABLE_TIKTOK_PUBLISH=false

# Automation
LOOP_COUNT=1
